# Copy this file to .env and adjust the values.
# docker-compose reads .env automatically.

# Docker Compose project name (sets the container name prefix)
COMPOSE_PROJECT_NAME=alcatraz

# API keys - pick your provider (opencode supports multiple backends)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-...
# GOOGLE_API_KEY=...
# OPENCODE_API_KEY=...

# Mega Brain memory vault path on the host.
# Default (if unset): ./.ai-context (local folder, created automatically).
# To sync with Obsidian/OneDrive, point this at your vault, e.g.:
#   Windows via WSL2: /mnt/c/Users/{user}/OneDrive/Documents/AIContext
#   Native Linux:     /home/{user}/Documents/AIContext
#   macOS:            /Users/{user}/Documents/AIContext
AI_CONTEXT_PATH=./.ai-context

# Node.js version (must be supported by NVM)
NODE_VERSION=22.19

# Optional Mega Brain prefix grouping. Set both to route repos whose name starts
# with the prefix into a vault subfolder (e.g. acme-web -> {vault}/Acme/acme-web).
MEGABRAIN_GROUP_PREFIX=
MEGABRAIN_GROUP_DIR=

# Extra projects to mount in the container (comma-separated).
# Each path is mounted at /workspace/projects/<folder-name>. Example:
# PROJECT_PATHS=/home/your-user/my-project,/home/your-user/another-project
PROJECT_PATHS=

# --- Modules (core is always ON and does not appear here) ---
# Core = the sandbox + Lighthouse (egress allowlist) + Guard (secret redaction).
# It is always on and cannot be toggled. Everything below is optional. Turn
# things on/off here or from the TUI Modules screen; an ALCATRAZ_MOD_* set in
# the environment overrides the line here (handy for CI/scripts).
ALCATRAZ_MOD_CHECKPOINTS=on       # safety net (default on)
ALCATRAZ_MOD_SESSIONS=on          # safety net (default on)
ALCATRAZ_MOD_STATS=on             # safety net (default on)
ALCATRAZ_MOD_MEGABRAIN=off        # opt-in — per-project persistent memory
ALCATRAZ_MOD_SHAKEDOWN=off        # opt-in — command-output compression (was 'slim')
ALCATRAZ_MOD_SPAWN=off            # opt-in — disposable sibling sandboxes
ALCATRAZ_MOD_WEBSEARCH=off        # opt-in — web lookups fetched by the host (see docs/modules/websearch.md)

# --- websearch: which endpoint the HOST queries -----------------------------
# These are read on the host by `alcatraz spawn-watch`, never inside the
# sandbox — the sandbox never sees a key and never talks to a search engine.
# Leave everything unset to use the keyless DuckDuckGo endpoint (best-effort:
# it often returns nothing). Set one of these for reliable results.
# ALCATRAZ_SEARCH_PROVIDER=ddg          # ddg | brave | searxng
# BRAVE_SEARCH_API_KEY=
# ALCATRAZ_SEARXNG_URL=https://searx.example.org
