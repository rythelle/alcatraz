{
  "defaultAction": "SCMP_ACT_ERRNO",
  "defaultErrnoRet": 1,
  "comment": "Alcatraz sandbox seccomp: default-DENY. Only the syscalls below are permitted; everything else (ptrace, mount, bpf, io_uring, kexec, module loading, perf_event_open, userfaultfd, process_vm_*, swap, reboot, firewall changes, ...) returns EPERM. This is a curated allowlist covering glibc, Node.js, Python, git, and the AI CLIs.",
  "archMap": [
    {
      "architecture": "SCMP_ARCH_X86_64",
      "subArchitectures": ["SCMP_ARCH_X86", "SCMP_ARCH_X32"]
    },
    {
      "architecture": "SCMP_ARCH_AARCH64",
      "subArchitectures": ["SCMP_ARCH_ARM"]
    }
  ],
  "syscalls": [
