      "action": "SCMP_ACT_ALLOW",
      "comment": "Baseline syscalls for glibc, Node.js, Python, git, curl and the AI CLIs"
    },
    {
      "names": ["clone"],
      "action": "SCMP_ACT_ALLOW",
      "comment": "Thread/process creation. Namespace flags are neutralised by cap_drop ALL (CLONE_NEW* needs CAP_SYS_ADMIN)."
    },
    {
      "names": ["clone3"],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 38,
      "comment": "Return ENOSYS so glibc falls back to clone() (matches Docker's default handling)."
    }
  ]
}
